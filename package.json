{
  "name": "noburi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:runtime": "pnpm --filter @noburi/runtime dev",
    "dev:desktop": "pnpm --filter @noburi/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
